# =============================================================================
# LifeOps — Root example environment file
# Copy to .env for local development. NEVER commit real values.
# =============================================================================

# --- Runtime ---
NODE_ENV=development
DEMO_MODE=true

# --- MCP server ---
# Port the MCP server binds. AgentCore Runtime requires 8000.
PORT=8000
# When containerized/AgentCore-deployed the server MUST listen on 0.0.0.0.
HOST=0.0.0.0
# Public base URL used by the web app to reach the MCP server.
MCP_BASE_URL=http://localhost:8000
# Path of the MCP endpoint. AgentCore convention.
MCP_PATH=/mcp
# Comma-separated origins allowed by CORS. Use "*" only for local dev.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Optional shared secret required in the X-LifeOps-Api-Key header. Empty = off (demo only).
LIFEOPS_API_KEY=

# --- Database ---
# Local dev: SQLite file path (relative to services/mcp-server).
DATABASE_URL=file:./data/lifeops.db

# --- Amazon Bedrock (optional; planner falls back to deterministic engine if missing) ---
AWS_REGION=us-east-1
# Set to a model ID available in YOUR account/region. Verify in the Bedrock console.
# Examples (verify current availability): anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MODEL_ID=
# Leave these empty and use IAM roles in AWS deployments. Populate only for local dev.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- Web app (apps/web) ---
WEB_PORT=5173

# --- Logging ---
LOG_LEVEL=info
